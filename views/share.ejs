<div class="share-card page-enter">
  <!-- Header -->
  <div style="padding:28px 32px 20px;border-bottom:1px solid var(--border-subtle);">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;flex-wrap:wrap;">
      <% if (expirationMode === 'single_use') { %>
        <span class="badge badge-accent"><span class="badge-dot"></span>usage unique</span>
      <% } else if (expirationMode === 'duration') { %>
        <span class="badge badge-warning"><span class="badge-dot"></span>durée fixe</span>
      <% } else { %>
        <span class="badge badge-success"><span class="badge-dot"></span>disponible</span>
      <% } %>
      <span class="mono text-faint" style="font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;max-width:120px;"><%= token %></span>
      <button type="button" id="share-clipboard-btn" style="margin-left:auto;background:none;border:none;cursor:pointer;color:var(--text-faint);padding:4px;border-radius:4px;" title="Copier le lien">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/>
        </svg>
      </button>
    </div>
    <h1 style="font-size:20px;font-weight:600;letter-spacing:-0.015em;margin:0 0 6px;word-break:break-word;"><%= name %></h1>
    <p style="font-size:13px;color:var(--text-dim);margin:0;">
      <%= files.length %> fichier<%= files.length > 1 ? 's' : '' %> · <%= totalSize %>
    </p>
    <% if (expirationMode === 'single_use') { %>
      <p id="single-use-hint" style="margin:8px 0 0;font-size:11.5px;color:var(--warning);">
        Usage unique : le lien sera détruit peu après le premier clic. Petite fenêtre de retry pour les coupures.
      </p>
    <% } %>
  </div>

  <!-- Bandeau d'expiration : affich\u00e9 d\u00e8s qu'un scheduledDeleteAt est connu (1h initial ou 5min apr\u00e8s clic) -->
  <div id="share-countdown-banner"
       data-scheduled-at="<%= typeof scheduledDeleteAtMs !== 'undefined' && scheduledDeleteAtMs ? scheduledDeleteAtMs : '' %>"
       style="display:none;padding:14px 32px;background:oklch(from var(--warning) l c h / 0.12);border-bottom:1px solid var(--border-subtle);text-align:center;font-size:12.5px;color:var(--warning);">
    <div><span id="share-countdown-label">Lien actif</span> — expire dans <strong id="share-countdown-value" class="mono">—</strong></div>
    <div style="margin-top:4px;font-size:11px;color:var(--text-dim);">
      Les téléchargements déjà lancés iront jusqu’à leur fin, même après expiration.
    </div>
  </div>

  <!-- Download actions -->
  <div style="padding:20px 32px;border-bottom:1px solid var(--border-subtle);display:flex;flex-wrap:wrap;gap:8px;">
    <a id="zip-download-btn"
       href="/d/<%= token %>/archive.zip"
       download="<%= zipBaseName %>.zip"
       rel="noopener"
       class="btn btn-primary btn-sm"
       title="Un seul fichier .zip à décompresser ensuite">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 4v12"/><path d="M7 11l5 5 5-5"/><path d="M4 20h16"/>
      </svg>
      Tout en un ZIP
    </a>
    <button type="button" id="download-dir-btn" class="btn btn-secondary btn-sm" style="display:none;"
      title="Écrire les fichiers directement dans votre dossier mémorisé (Chrome / Edge / Brave uniquement)">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
      </svg>
      <span id="download-dir-btn-label">Choisir un dossier</span>
    </button>
    <button type="button" id="download-dir-change-btn" class="btn btn-ghost btn-sm" style="display:none;"
      title="Changer le dossier de destination mémorisé">
      Changer
    </button>
    <button type="button" id="download-dir-forget-btn" class="btn btn-ghost btn-sm" style="display:none;color:var(--text-faint);font-size:11px;padding:6px 8px;"
      title="Oublier le dossier mémorisé (re-choisir au prochain téléchargement)">
      Oublier
    </button>
    <a href="/d/<%= token %>/liens.txt" class="btn btn-ghost btn-sm" title="Liens CDN directs (JDownloader, aria2c…)">Fichier de liens (.txt)</a>
    <p id="download-dir-status" style="display:none;width:100%;font-size:11px;color:var(--text-dim);margin:0;"></p>
  </div>

  <!-- File list -->
  <ul id="file-list" style="max-height:min(60vh,28rem);overflow-y:auto;padding:0;margin:0;list-style:none;">
    <% files.forEach(function(f) { %>
      <li class="file-row" id="file-row-<%= f.id %>"
          data-file-id="<%= f.id %>"
          style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 32px;border-bottom:1px solid var(--border-subtle);">
        <div style="min-width:0;flex:1;">
          <div style="word-break:break-word;font-size:13px;color:var(--text);"><%= f.filename %></div>
          <div class="mono text-faint" style="font-size:11.5px;margin-top:2px;">
            <span><%= f.size %></span>
          </div>
        </div>
        <a href="/d/<%= token %>/f/<%= f.id %>"
           download="<%= f.filename %>"
           rel="noopener"
           class="js-file-download btn btn-secondary btn-sm"
           data-file-id="<%= f.id %>"
           style="flex-shrink:0;">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 4v12"/><path d="M7 11l5 5 5-5"/><path d="M4 20h16"/>
          </svg>
          Télécharger
        </a>
      </li>
    <% }); %>
  </ul>
</div>

<script type="application/json" id="share-meta"><%- shareMetaJson %></script>

<script>
(function () {
  var meta = {};
  try { meta = JSON.parse(document.getElementById('share-meta').textContent || '{}'); } catch (e) {}
  var TOKEN = meta.token;
  var IS_SINGLE_USE = meta.expirationMode === 'single_use';
  var FILES = (meta.files || []).slice();
  var scheduledAt = meta.scheduledDeleteAtMs ? parseInt(meta.scheduledDeleteAtMs, 10) : null;

  // ---------- Countdown (1 h initial, raccourci \u00e0 5 min apr\u00e8s clic) ----------
  var banner = document.getElementById('share-countdown-banner');
  var bannerVal = document.getElementById('share-countdown-value');
  var bannerLabel = document.getElementById('share-countdown-label');
  var hintEl = document.getElementById('single-use-hint');
  var countdownTimer = null;
  var anyClicked = (FILES.some(function (x) { return x.streamed; }));

  function setBannerLabel() {
    if (!bannerLabel) return;
    bannerLabel.textContent = anyClicked ? 'Lien consommé' : 'Lien actif';
  }

  function startCountdown(targetMs) {
    if (!IS_SINGLE_USE || !banner || !bannerVal) return;
    scheduledAt = targetMs;
    banner.style.display = '';
    if (hintEl) hintEl.style.display = 'none';
    setBannerLabel();
    if (countdownTimer) clearInterval(countdownTimer);
    function tick() {
      var ms = (scheduledAt || 0) - Date.now();
      if (ms <= 0) {
        bannerVal.textContent = 'expiré';
        clearInterval(countdownTimer); countdownTimer = null;
        setTimeout(function () { location.reload(); }, 600);
        return;
      }
      var s = Math.floor(ms / 1000);
      var h = Math.floor(s / 3600);
      var m = Math.floor((s % 3600) / 60);
      var ss = s % 60;
      var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
      bannerVal.textContent = h > 0
        ? h + 'h ' + pad(m) + 'm ' + pad(ss) + 's'
        : m + 'm ' + pad(ss) + 's';
    }
    tick();
    countdownTimer = setInterval(tick, 1000);
  }

  // Le serveur pose scheduledDeleteAt dès que la release est ready : on lance imm\u00e9diatement.
  if (IS_SINGLE_USE && scheduledAt && scheduledAt > Date.now()) {
    startCountdown(scheduledAt);
  }

  function markFileClickedUI(fileId) {
    var f = FILES.find(function (x) { return x.id === fileId; });
    if (f) f.streamed = true;
    if (IS_SINGLE_USE) {
      // Premier clic : raccourcit le countdown UI à 5 min (le serveur fait pareil côté DB).
      var clickTarget = Date.now() + 5 * 60 * 1000;
      if (!scheduledAt || clickTarget < scheduledAt) {
        anyClicked = true;
        startCountdown(clickTarget);
      } else {
        anyClicked = true;
        setBannerLabel();
      }
    }
  }

  // ---------- Clipboard ----------
  var clipBtn = document.getElementById('share-clipboard-btn');
  if (clipBtn) {
    var _clipOrig = clipBtn.innerHTML;
    var _clipCheck = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>';
    function copyShareUrl(onSuccess) {
      var text = window.location.href;
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(onSuccess).catch(function () { fallbackShareCopy(text, onSuccess); });
      } else {
        fallbackShareCopy(text, onSuccess);
      }
    }
    function fallbackShareCopy(text, onSuccess) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.cssText = 'position:fixed;top:-9999px;left:-9999px;opacity:0;';
      document.body.appendChild(ta);
      ta.focus(); ta.select();
      try { if (document.execCommand('copy')) onSuccess(); } catch (e) {}
      document.body.removeChild(ta);
    }
    clipBtn.addEventListener('click', function () {
      copyShareUrl(function () {
        clipBtn.innerHTML = _clipCheck;
        clipBtn.style.color = 'var(--success)';
        setTimeout(function () { clipBtn.innerHTML = _clipOrig; clipBtn.style.color = ''; }, 1800);
      });
    });
  }

  // ---------- Per-file 302 click (browser handles the actual download) ----------
  document.querySelectorAll('.js-file-download').forEach(function (a) {
    a.addEventListener('click', function () {
      var id = parseInt(a.getAttribute('data-file-id'), 10);
      if (!isNaN(id)) markFileClickedUI(id);
    });
  });

  // ---------- Enregistrer dans un dossier (File System Access API, Chromium only) ----------
  // L'utilisateur choisit UN dossier UNE fois, on mémorise le FileSystemDirectoryHandle
  // dans IndexedDB (persisté entre sessions et entre pages /d/:token). Les
  // téléchargements suivants iront dans ce même dossier sans demander à nouveau.
  // Un sous-dossier nommé d'après chaque release est créé automatiquement pour
  // garder les fichiers de différentes releases bien séparés.
  //
  // Côté permission : le navigateur stocke aussi le consentement (avec la case
  // « toujours autoriser » dans la modale Chrome on a 1 seul prompt total, sinon
  // potentiellement 1 prompt par session pour redonner accès au handle persisté).
  var dirBtn = document.getElementById('download-dir-btn');
  var dirBtnLabel = document.getElementById('download-dir-btn-label');
  var dirChangeBtn = document.getElementById('download-dir-change-btn');
  var dirForgetBtn = document.getElementById('download-dir-forget-btn');
  var dirStat = document.getElementById('download-dir-status');
  var supportsFsApi = ('showDirectoryPicker' in window) && window.isSecureContext;
  if (dirBtn && dirStat && supportsFsApi) {
    dirBtn.style.display = '';
    var dirAc = null;
    var storedHandle = null;

    function sanitizeFolderName(name) {
      return (name || 'release').replace(/[\\/:*?"<>|\u0000-\u001f]/g, '_').slice(0, 80) || 'release';
    }

    // --- Mini wrapper IndexedDB : un seul magasin "kv" avec une clé fixe.
    function openIDB() {
      return new Promise(function (resolve, reject) {
        var req = indexedDB.open('shadebrid', 1);
        req.onupgradeneeded = function () {
          var db = req.result;
          if (!db.objectStoreNames.contains('kv')) db.createObjectStore('kv');
        };
        req.onerror = function () { reject(req.error); };
        req.onsuccess = function () { resolve(req.result); };
      });
    }
    function idbGet(key) {
      return openIDB().then(function (db) {
        return new Promise(function (resolve, reject) {
          var tx = db.transaction('kv', 'readonly');
          var st = tx.objectStore('kv').get(key);
          st.onsuccess = function () { resolve(st.result); };
          st.onerror = function () { reject(st.error); };
        });
      });
    }
    function idbSet(key, value) {
      return openIDB().then(function (db) {
        return new Promise(function (resolve, reject) {
          var tx = db.transaction('kv', 'readwrite');
          tx.objectStore('kv').put(value, key);
          tx.oncomplete = function () { resolve(); };
          tx.onerror = function () { reject(tx.error); };
        });
      });
    }
    function idbDelete(key) {
      return openIDB().then(function (db) {
        return new Promise(function (resolve, reject) {
          var tx = db.transaction('kv', 'readwrite');
          tx.objectStore('kv').delete(key);
          tx.oncomplete = function () { resolve(); };
          tx.onerror = function () { reject(tx.error); };
        });
      });
    }

    var HANDLE_KEY = 'downloadsDirHandle';

    function setStatus(text, kind) {
      if (!text) { dirStat.style.display = 'none'; dirStat.textContent = ''; return; }
      dirStat.style.display = '';
      dirStat.textContent = text;
      dirStat.style.color = kind === 'error' ? 'var(--danger)' :
                            kind === 'success' ? 'var(--success)' :
                            'var(--text-dim)';
    }
    function refreshUI() {
      if (storedHandle) {
        dirBtnLabel.textContent = 'Enregistrer dans « ' + (storedHandle.name || 'dossier') + ' »';
        dirChangeBtn.style.display = '';
        dirForgetBtn.style.display = '';
      } else {
        dirBtnLabel.textContent = 'Choisir un dossier';
        dirChangeBtn.style.display = 'none';
        dirForgetBtn.style.display = 'none';
      }
    }

    // Vérifie qu'on a (ou peut redemander silencieusement) une permission
    // readwrite sur le handle stocké. `interactive=true` permet de déclencher
    // un prompt si nécessaire (doit être appelé depuis un click handler user).
    async function ensurePermission(handle, interactive) {
      if (!handle || !handle.queryPermission) return false;
      var perm = await handle.queryPermission({ mode: 'readwrite' });
      if (perm === 'granted') return true;
      if (interactive && handle.requestPermission) {
        perm = await handle.requestPermission({ mode: 'readwrite' });
        return perm === 'granted';
      }
      return false;
    }

    // Charge le handle au boot, sans déclencher de prompt.
    idbGet(HANDLE_KEY).then(function (h) {
      if (h && h.kind === 'directory') {
        storedHandle = h;
        refreshUI();
      }
    }).catch(function () { /* IDB indisponible, on continue sans persistance */ });

    async function pickNewFolder() {
      var root;
      try {
        root = await window.showDirectoryPicker({
          id: 'shadebrid-downloads',
          mode: 'readwrite',
          startIn: 'downloads',
        });
      } catch (e) {
        if (e && e.name === 'AbortError') return null;
        setStatus('Sélecteur indisponible : ' + (e.message || e), 'error');
        return null;
      }
      try {
        await idbSet(HANDLE_KEY, root);
      } catch (e) {
        // Persistance impossible (mode privé strict ?) : on garde quand même en mémoire pour cette session.
        // eslint-disable-next-line no-console
        console.warn('[dl-dir] persistance IDB échouée', e);
      }
      storedHandle = root;
      refreshUI();
      return root;
    }

    async function runDownloadInto(root) {
      // Sous-dossier auto par release pour ne pas mélanger.
      var folderName = sanitizeFolderName(meta.zipBaseName);
      var target;
      try {
        target = await root.getDirectoryHandle(folderName, { create: true });
      } catch (e) {
        setStatus('Création du sous-dossier impossible : ' + (e.message || e), 'error');
        return;
      }

      dirBtn.disabled = true;
      dirChangeBtn.disabled = true;
      dirAc = new AbortController();
      var done = 0, failed = 0, total = FILES.length;
      function refresh(extra) {
        var msg = 'dossier ' + root.name + ' / ' + folderName + ' · ' + done + ' / ' + total + ' OK';
        if (failed > 0) msg += ' · ' + failed + ' échec(s)';
        if (extra) msg += ' · ' + extra;
        setStatus(msg, failed > 0 && done + failed === total ? 'error' : null);
      }
      refresh('démarrage');

      var queue = FILES.slice();
      var CONCURRENCY = Math.min(3, queue.length);

      async function downloadOne(file) {
        var url = '/d/' + encodeURIComponent(TOKEN) + '/f/' + encodeURIComponent(file.id) + '/stream';
        var fileName = sanitizeFolderName(file.filename);
        var res = await fetch(url, { signal: dirAc.signal, credentials: 'same-origin' });
        if (!res.ok || !res.body) throw new Error('HTTP ' + res.status);
        var handle = await target.getFileHandle(fileName, { create: true });
        var writable = await handle.createWritable();
        try {
          await res.body.pipeTo(writable);
        } catch (err) {
          try { await writable.abort(); } catch (e) {}
          throw err;
        }
        markFileClickedUI(file.id);
      }
      async function worker() {
        while (queue.length > 0) {
          if (dirAc.signal.aborted) return;
          var f = queue.shift();
          if (!f) return;
          try {
            await downloadOne(f);
            done++;
          } catch (err) {
            failed++;
            // eslint-disable-next-line no-console
            console.warn('[dl-dir] échec', f.filename, err);
          }
          refresh();
        }
      }
      var workers = [];
      for (var w = 0; w < CONCURRENCY; w++) workers.push(worker());
      await Promise.all(workers);

      refresh(failed === 0 ? 'terminé' : 'terminé avec ' + failed + ' échec(s)');
      dirBtn.disabled = false;
      dirChangeBtn.disabled = false;

      if (IS_SINGLE_USE && done > 0) {
        var clickTarget = Date.now() + 5 * 60 * 1000;
        if (!scheduledAt || clickTarget < scheduledAt) {
          anyClicked = true; startCountdown(clickTarget);
        }
      }
    }

    dirBtn.addEventListener('click', async function () {
      if (dirBtn.disabled) return;
      if (FILES.length === 0) return;
      var root = storedHandle;
      // Si on a un handle persisté on essaie de l'utiliser, sinon on en demande un nouveau.
      if (root) {
        var ok = await ensurePermission(root, true);
        if (!ok) {
          setStatus('Accès au dossier refusé. Cliquez pour en choisir un autre.', 'error');
          // On ne le supprime pas tout de suite : peut-être que l'user a juste annulé.
          return;
        }
      } else {
        root = await pickNewFolder();
        if (!root) return; // user annulé
      }
      await runDownloadInto(root);
    });

    if (dirChangeBtn) {
      dirChangeBtn.addEventListener('click', async function () {
        var root = await pickNewFolder();
        if (root) setStatus('Nouveau dossier mémorisé : ' + root.name, 'success');
      });
    }
    if (dirForgetBtn) {
      dirForgetBtn.addEventListener('click', async function () {
        try { await idbDelete(HANDLE_KEY); } catch (e) {}
        storedHandle = null;
        refreshUI();
        setStatus('Dossier oublié — vous serez à nouveau invité à en choisir un.', 'success');
        setTimeout(function () { setStatus(''); }, 2500);
      });
    }
  }

  // ---------- ZIP (download natif du navigateur, 0 buffer RAM côté client) ----------
  // Le bouton est un <a href download>. On laisse le navigateur streamer le ZIP
  // directement dans Downloads/ : pas de fetch() ni d'accumulation en RAM, donc
  // ça scale aux releases de plusieurs Go sans faire crasher l'onglet.
  // Coût : on perd la progress bar custom (la barre native du navigateur en bas
  // de la fenêtre prend le relais). C'est le compromis assumé pour la fiabilité.
  //
  // Côté serveur, /archive.zip fait `markZipDownloaded` sur archive.on('end')
  // → l'expiration single_use est appliquée correctement quand le navigateur a
  // tout consommé. Ici on marque juste l'UI optimistement au clic.
  var zipBtn = document.getElementById('zip-download-btn');
  if (zipBtn) {
    zipBtn.addEventListener('click', function () {
      // Optimiste : on suppose que le téléchargement va aboutir. Le countdown
      // single_use se mettra à jour comme s'il y avait eu un clic sur chaque
      // fichier. Si la connexion casse côté client, le serveur n'aura pas
      // appelé markZipDownloaded, donc la release reste en vie pour retry.
      if (IS_SINGLE_USE) {
        FILES.forEach(function (x) { markFileClickedUI(x.id); });
      }
    });
  }
})();
</script>
