<!doctype html>
<html lang="fr" style="height:100%;background:var(--bg)">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · <%= appName %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/static/styles/app.css" />
    <link rel="icon" type="image/svg+xml" href="/static/favicon.svg" />
  </head>
  <body style="min-height:100vh;display:flex;flex-direction:column;background:radial-gradient(ellipse 70% 40% at 50% 0%, oklch(from var(--accent) l c h / 0.07), transparent 60%), var(--bg);">
    <main style="flex:1;display:flex;flex-direction:column;align-items:center;padding:40px 20px 60px;">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:32px;align-self:flex-start;max-width:560px;width:100%;">
        <div class="brand-mark" style="width:24px;height:24px;border-radius:6px;font-size:12px;">
          <%= typeof appName !== 'undefined' && appName ? appName.charAt(0).toUpperCase() : 'R' %>
        </div>
        <span style="font-size:13px;font-weight:600;"><%= appName %></span>
      </div>
      <div style="width:100%;max-width:560px;">
        <%- body %>
      </div>
    </main>
    <footer style="padding:16px 20px;text-align:center;font-size:11.5px;color:var(--text-faint);">
      <%= appName %> · self-hosted
    </footer>
  </body>
</html>
