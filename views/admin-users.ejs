<div class="page-header">
  <div class="page-header-inner">
    <div>
      <h1 class="page-title">
        <svg class="page-title-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        Utilisateurs
      </h1>
      <p class="page-subtitle">Gérez les comptes ayant accès à l'application.</p>
    </div>
    <div class="page-header-actions">
      <span class="mono text-faint" style="font-size:11.5px;"><%= users.length %> compte<%= users.length > 1 ? 's' : '' %></span>
    </div>
  </div>
</div>

<div class="page-body page-enter">
  <div class="page-body-inner">
  <div style="display:grid;grid-template-columns:1fr 340px;gap:24px;align-items:start;">

    <!-- Users table -->
    <div class="card" style="padding:0;overflow:hidden;">
      <table class="tbl">
        <thead>
          <tr>
            <th style="padding-left:22px;">Identifiant</th>
            <th>Rôle</th>
            <th style="text-align:right;">DL</th>
            <th>Créé le</th>
            <th style="width:80px;"></th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(u) { %>
            <tr>
              <td style="padding-left:22px;">
                <div style="display:flex;align-items:center;gap:12px;">
                  <div class="user-avatar"><%= u.username.charAt(0).toUpperCase() %></div>
                  <div>
                    <div style="font-weight:500;">
                      <%= u.username %>
                      <% if (u.id === user.id) { %><span style="font-size:11px;color:var(--accent);margin-left:6px;">vous</span><% } %>
                    </div>
                    <div class="mono text-faint" style="font-size:11px;"><%= u.id %></div>
                  </div>
                </div>
              </td>
              <td>
                <form method="post" action="/admin/users/<%= u.id %>/role" style="display:inline-flex;align-items:center;gap:8px;" onsubmit="return true;">
                  <select name="role" class="sel" style="width:auto;padding:4px 24px 4px 8px;font-size:12px;">
                    <option value="user"  <%= u.role === 'user'  ? 'selected' : '' %>>user</option>
                    <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin</option>
                  </select>
                  <button type="submit" class="btn btn-ghost btn-sm" title="Appliquer" style="padding:4px 6px;">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg>
                  </button>
                </form>
              </td>
              <td style="text-align:right;"><span class="mono"><%= u.downloadCount %></span></td>
              <td><span style="font-size:12.5px;color:var(--text-muted);"><%= u.createdAt %></span></td>
              <td>
                <div style="display:flex;justify-content:flex-end;gap:4px;padding-right:8px;">
                  <% if (u.id !== user.id) { %>
                    <details style="position:relative;">
                      <summary class="btn btn-ghost btn-sm" style="list-style:none;cursor:pointer;">···</summary>
                      <div style="position:absolute;right:0;top:calc(100% + 4px);z-index:10;min-width:220px;background:var(--surface);border:1px solid var(--border);border-radius:var(--r-md);padding:10px;box-shadow:var(--shadow-md);">
                        <% if (u.role !== 'admin') { %>
                        <div style="margin-bottom:10px;">
                          <div class="meta-label" style="margin-bottom:6px;">Expirations autorisées</div>
                          <form method="post" action="/admin/users/<%= u.id %>/permissions" style="display:flex;flex-direction:column;gap:5px;">
                            <label style="display:flex;align-items:center;gap:7px;font-size:12px;cursor:pointer;">
                              <input type="checkbox" name="single_use" value="1" <%= u.allowedExpirationModes.includes('single_use') ? 'checked' : '' %> style="accent-color:var(--accent);" />
                              Usage unique
                            </label>
                            <label style="display:flex;align-items:center;gap:7px;font-size:12px;cursor:pointer;">
                              <input type="checkbox" name="duration" value="1" <%= u.allowedExpirationModes.includes('duration') ? 'checked' : '' %> style="accent-color:var(--accent);" />
                              Durée fixe
                            </label>
                            <label style="display:flex;align-items:center;gap:7px;font-size:12px;cursor:pointer;">
                              <input type="checkbox" name="none" value="1" <%= u.allowedExpirationModes.includes('none') ? 'checked' : '' %> style="accent-color:var(--accent);" />
                              Sans limite
                            </label>
                            <button class="btn btn-secondary btn-sm" style="margin-top:4px;align-self:flex-end;">Enregistrer</button>
                          </form>
                        </div>
                        <div style="height:1px;background:var(--border-subtle);margin:2px 0 8px;"></div>
                        <% } %>
                        <form method="post" action="/admin/users/<%= u.id %>/password" style="display:flex;gap:6px;margin-bottom:8px;">
                          <input name="password" type="text" placeholder="nouveau mot de passe" class="input" style="font-size:12px;padding:5px 8px;" />
                          <button class="btn btn-secondary btn-sm">OK</button>
                        </form>
                        <form method="post" action="/admin/users/<%= u.id %>/delete">
                          <button type="button" class="btn btn-danger-ghost btn-sm" data-confirm="Supprimer cet utilisateur ?" onclick="doConfirm(this)">
                            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M4 7h16"/><path d="M9 7V4h6v3"/><path d="M6 7l1 13a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-13"/>
                            </svg>
                            Supprimer
                          </button>
                        </form>
                      </div>
                    </details>
                  <% } else { %>
                    <span class="text-faint" style="font-size:12px;padding:4px 8px;">—</span>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Create user panel -->
    <form method="post" action="/admin/users" class="card" style="position:sticky;top:28px;">
      <h3 class="card-title">
        <svg class="card-title-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="18" y1="11" x2="24" y2="11"/><line x1="21" y1="8" x2="21" y2="14"/>
        </svg>
        Créer un utilisateur
      </h3>
      <p class="card-sub">Mot de passe d'au moins 6 caractères requis.</p>

      <div style="display:grid;gap:14px;">
        <div class="field">
          <label class="label">Identifiant</label>
          <input name="username" type="text" required autocomplete="off" class="input mono" placeholder="ex: mira" />
        </div>
        <div class="field">
          <label class="label">Mot de passe <span class="label-hint">(≥ 6 caractères)</span></label>
          <input name="password" type="text" required minlength="6" autocomplete="new-password" class="input mono" />
        </div>
        <div class="field">
          <label class="label">Rôle</label>
          <select name="role" class="sel">
            <option value="user">user</option>
            <option value="admin">admin</option>
          </select>
        </div>
      </div>

      <div style="height:18px;"></div>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">Créer</button>
    </form>

  </div>
  </div>
</div>
