<div class="page-header">
  <div class="page-header-inner">
    <div>
      <h1 class="page-title">
        <svg class="page-title-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        Utilisateurs
      </h1>
      <p class="page-subtitle">Gérez les comptes ayant accès à l'application.</p>
    </div>
    <div class="page-header-actions">
      <span class="mono text-faint" style="font-size:11.5px;"><%= users.length %> compte<%= users.length > 1 ? 's' : '' %></span>
    </div>
  </div>
</div>

<div class="page-body page-enter">
  <div class="page-body-inner">
  <div style="display:grid;grid-template-columns:1fr 340px;gap:24px;align-items:start;">

    <!-- Users table -->
    <div style="display:flex;flex-direction:column;gap:10px;">
      <% users.forEach(function(u) { %>
        <div class="card" style="padding:16px 20px;">

          <!-- Row 1 : identity + role + stats -->
          <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
            <div style="display:flex;align-items:center;gap:10px;flex:1;min-width:140px;">
              <div class="user-avatar"><%= u.username.charAt(0).toUpperCase() %></div>
              <div>
                <div style="font-weight:600;font-size:13.5px;">
                  <%= u.username %>
                  <% if (u.id === user.id) { %><span style="font-size:11px;color:var(--accent);margin-left:5px;">vous</span><% } %>
                </div>
                <div class="mono text-faint" style="font-size:11px;">id <%= u.id %> · <%= u.downloadCount %> DL · <%= u.createdAt %></div>
              </div>
            </div>

            <!-- Role -->
            <form method="post" action="/admin/users/<%= u.id %>/role" style="display:inline-flex;align-items:center;gap:6px;">
              <select name="role" class="sel" style="width:auto;padding:4px 24px 4px 8px;font-size:12px;">
                <option value="user"  <%= u.role === 'user'  ? 'selected' : '' %>>user</option>
                <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin</option>
              </select>
              <button type="submit" class="btn btn-ghost btn-sm" title="Appliquer rôle" style="padding:4px 6px;">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg>
              </button>
            </form>
          </div>

          <% if (u.id !== user.id) { %>
          <div style="height:1px;background:var(--border-subtle);margin:12px 0;"></div>

          <!-- Row 2 : permissions + password + delete -->
          <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">

            <!-- Expiration permissions -->
            <% if (u.role !== 'admin') { %>
            <form method="post" action="/admin/users/<%= u.id %>/permissions" style="display:flex;align-items:center;gap:5px;flex-wrap:wrap;">
              <span class="meta-label" style="white-space:nowrap;">Expirations :</span>
              <label class="perm-pill <%= u.allowedExpirationModes.includes('single_use') ? 'on' : '' %>">
                <input type="checkbox" name="single_use" value="1" <%= u.allowedExpirationModes.includes('single_use') ? 'checked' : '' %> />
                Usage unique
              </label>
              <label class="perm-pill <%= u.allowedExpirationModes.includes('duration') ? 'on' : '' %>">
                <input type="checkbox" name="duration" value="1" <%= u.allowedExpirationModes.includes('duration') ? 'checked' : '' %> />
                Durée fixe
              </label>
              <label class="perm-pill <%= u.allowedExpirationModes.includes('none') ? 'on' : '' %>">
                <input type="checkbox" name="none" value="1" <%= u.allowedExpirationModes.includes('none') ? 'checked' : '' %> />
                Sans limite
              </label>
              <button type="submit" class="btn btn-ghost btn-sm" title="Sauvegarder" style="padding:3px 6px;">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg>
              </button>
            </form>
            <% } else { %>
              <span style="font-size:11.5px;color:var(--text-faint);">Expirations : toutes (admin)</span>
            <% } %>

            <div style="margin-left:auto;display:flex;align-items:center;gap:6px;">
              <!-- Password change inline -->
              <span id="pw-btn-<%= u.id %>">
                <button type="button" class="btn btn-ghost btn-sm" onclick="showPwForm('<%= u.id %>')">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                  Mot de passe
                </button>
              </span>
              <form id="pw-form-<%= u.id %>" method="post" action="/admin/users/<%= u.id %>/password"
                style="display:none;align-items:center;gap:5px;flex-wrap:wrap;">
                <input name="password" type="text" placeholder="nouveau mot de passe" class="input"
                  style="font-size:12px;padding:5px 9px;width:170px;max-width:100%;flex:1;min-width:120px;" />
                <button type="submit" class="btn btn-secondary btn-sm">OK</button>
                <button type="button" class="btn btn-ghost btn-sm" onclick="hidePwForm('<%= u.id %>')">✕</button>
              </form>

              <!-- Delete inline -->
              <span id="del-u-<%= u.id %>" style="display:inline-flex;align-items:center;gap:4px;">
                <button type="button" class="btn btn-danger-ghost btn-sm" id="del-u-btn-<%= u.id %>" onclick="askDelUser('<%= u.id %>')">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 7h16"/><path d="M9 7V4h6v3"/><path d="M6 7l1 13a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-13"/>
                  </svg>
                  Supprimer
                </button>
                <span id="del-u-confirm-<%= u.id %>" style="display:none;align-items:center;gap:4px;">
                  <span style="font-size:12px;color:var(--text-dim);white-space:nowrap;">Supprimer ?</span>
                  <form method="post" action="/admin/users/<%= u.id %>/delete" style="display:inline;">
                    <button type="submit" class="btn btn-danger btn-sm">Oui</button>
                  </form>
                  <button type="button" class="btn btn-ghost btn-sm" onclick="cancelDelUser('<%= u.id %>')">Non</button>
                </span>
              </span>
            </div>
          </div>
          <% } %>

        </div>
      <% }); %>
    </div>

    <!-- Create user panel -->
    <form method="post" action="/admin/users" class="card" style="position:sticky;top:28px;">
      <h3 class="card-title">
        <svg class="card-title-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="18" y1="11" x2="24" y2="11"/><line x1="21" y1="8" x2="21" y2="14"/>
        </svg>
        Créer un utilisateur
      </h3>
      <p class="card-sub">Mot de passe d'au moins 6 caractères requis.</p>

      <div style="display:grid;gap:14px;">
        <div class="field">
          <label class="label">Identifiant</label>
          <input name="username" type="text" required autocomplete="off" class="input mono" placeholder="ex: mira" />
        </div>
        <div class="field">
          <label class="label">Mot de passe <span class="label-hint">(≥ 6 caractères)</span></label>
          <input name="password" type="text" required minlength="6" autocomplete="new-password" class="input mono" />
        </div>
        <div class="field">
          <label class="label">Rôle</label>
          <select name="role" class="sel">
            <option value="user">user</option>
            <option value="admin">admin</option>
          </select>
        </div>
      </div>

      <div style="height:18px;"></div>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">Créer</button>
    </form>

  </div>
  </div>
</div>

<script>
document.querySelectorAll('.perm-pill input').forEach(function(cb) {
  cb.addEventListener('change', function() {
    var label = cb.closest('label');
    if (cb.checked) label.classList.add('on');
    else label.classList.remove('on');
  });
});

function showPwForm(id) {
  document.getElementById('pw-btn-' + id).style.display = 'none';
  var form = document.getElementById('pw-form-' + id);
  form.style.display = 'inline-flex';
  form.querySelector('input').focus();
}
function hidePwForm(id) {
  document.getElementById('pw-btn-' + id).style.display = '';
  var form = document.getElementById('pw-form-' + id);
  form.style.display = 'none';
  form.querySelector('input').value = '';
}

function askDelUser(id) {
  document.getElementById('del-u-btn-' + id).style.display = 'none';
  document.getElementById('del-u-confirm-' + id).style.display = 'inline-flex';
}
function cancelDelUser(id) {
  document.getElementById('del-u-btn-' + id).style.display = '';
  document.getElementById('del-u-confirm-' + id).style.display = 'none';
}
</script>
