<div class="share-card page-enter" style="padding:48px 36px;text-align:center;">
  <div style="width:48px;height:48px;border-radius:12px;background:var(--surface-active);display:grid;place-items:center;margin:0 auto 18px;color:var(--text-faint);">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="9"/>
      <path d="M12 8v4"/><circle cx="12" cy="16" r="0.5" fill="currentColor"/>
    </svg>
  </div>
  <h1 style="font-size:20px;font-weight:600;letter-spacing:-0.015em;margin:0 0 8px;"><%= title %></h1>
  <p style="font-size:13.5px;color:var(--text-dim);margin:0;"><%= reason %></p>
  <% if (typeof autoRefresh !== "undefined" && autoRefresh) { %>
    <p style="margin-top:16px;font-size:12px;color:var(--text-faint);">Cette page se recharge automatiquement dès que le lien est prêt.</p>
    <script>setInterval(function(){ location.reload(); }, 4000);</script>
  <% } %>
</div>
