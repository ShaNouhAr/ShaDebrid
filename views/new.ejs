<div class="page-header" style="--inner-max:640px;">
  <div class="page-header-inner">
    <div>
      <h1 class="page-title">
        <svg class="page-title-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Téléchargement
      </h1>
      <p class="page-subtitle">Créez un nouveau lien de partage à partir d'un torrent, magnet ou URL.</p>
    </div>
  </div>
</div>

<div class="page-body page-enter">
  <div class="page-body-inner" style="max-width:640px;">
  <% if (!hasApiKey) { %>
    <div class="flash-bar error" style="margin:0 0 22px;">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12"/><path d="M18 6L6 18"/></svg>
      Envoi désactivé : clé API manquante.
      <% if (user.role === 'admin') { %>
        <a href="/admin/settings" style="color:var(--accent);margin-left:4px;">Configurer</a>
      <% } else { %>
        <span style="color:var(--text-dim);margin-left:4px;">Contacter un administrateur.</span>
      <% } %>
    </div>
  <% } %>

  <form method="post" action="/new" enctype="multipart/form-data" style="display:flex;flex-direction:column;gap:22px;">

    <!-- Source card -->
    <div class="card">
      <h3 class="card-title">
        <svg class="card-title-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
        </svg>
        Source
      </h3>
      <p class="card-sub">Choisissez la source du téléchargement à partager.</p>

      <!-- Segmented tab selector -->
      <div class="seg" id="src-tabs">
        <button type="button" class="seg-item active" data-tab="torrent">Fichier .torrent</button>
        <button type="button" class="seg-item" data-tab="magnet">Liens magnet / URL</button>
      </div>

      <div style="height:18px;"></div>

      <!-- Torrent drop zone -->
      <div id="tab-torrent">
        <div class="dropzone" id="torrent-zone" onclick="document.getElementById('torrent-input').click()">
          <div class="dropzone-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9"/><path d="M12 3v9l6 4"/>
            </svg>
          </div>
          <div class="dropzone-title" id="torrent-title">Déposez un fichier .torrent</div>
          <div class="dropzone-sub" id="torrent-sub">ou <span style="color:var(--accent);">cliquez pour parcourir</span></div>
          <input id="torrent-input" name="torrent" type="file" accept=".torrent,application/x-bittorrent" style="display:none;" />
        </div>
      </div>

      <!-- Magnet/URL textarea -->
      <div id="tab-magnet" style="display:none;">
        <div class="field">
          <label class="label">Liens <span class="label-hint">(magnets ou URL, un par ligne)</span></label>
          <textarea name="links" class="textarea mono" placeholder="magnet:?xt=urn:btih:&#10;https://…" style="min-height:120px;"></textarea>
        </div>
      </div>
    </div>

    <!-- Access & expiration card -->
    <div class="card">
      <h3 class="card-title">
        <svg class="card-title-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        Accès &amp; expiration
      </h3>
      <p class="card-sub">Définit qui peut accéder au lien et combien de temps.</p>

      <div style="display:grid;gap:18px;">
        <!-- Password -->
        <div class="field">
          <div class="toggle-wrap" style="cursor:pointer;display:flex;align-items:center;gap:10px;user-select:none;" onclick="togglePasswordField()">
            <span class="toggle-track" id="pass-toggle-track" style="position:relative;width:34px;height:20px;border-radius:10px;background:var(--surface-active);border:1px solid var(--border);flex-shrink:0;transition:background 0.15s,border 0.15s;">
              <span id="pass-toggle-thumb" style="position:absolute;top:2px;left:2px;width:14px;height:14px;border-radius:50%;background:var(--text-faint);transition:transform 0.15s,background 0.15s;"></span>
            </span>
            <span style="font-size:13px;font-weight:500;color:var(--text-muted);">Protéger par mot de passe</span>
          </div>
          <div id="password-wrap" style="display:none;margin-top:8px;position:relative;">
            <input id="password-field" name="password" type="password" autocomplete="off"
              placeholder="Mot de passe du lien"
              class="input mono" style="padding-right:38px;" />
            <button type="button" id="toggle-pass"
              style="position:absolute;right:8px;top:50%;transform:translateY(-50%);color:var(--text-dim);padding:4px;border-radius:4px;"
              aria-label="Afficher / masquer">
              <svg id="eye-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Expiration -->
        <div class="field">
          <label class="label">Expiration</label>
          <div class="exp-grid">
            <label class="exp-opt active" id="exp-once" onclick="selectExp('single_use',this)">
              <input type="radio" name="expirationMode" value="single_use" checked style="display:none;" />
              <div class="exp-opt-title">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3v6"/><path d="M12 15v6"/><path d="M3 12h6"/><path d="M15 12h6"/>
                </svg>
                Usage unique
              </div>
              <div class="exp-opt-sub">Détruit après le 1ᵉʳ accès</div>
            </label>

            <label class="exp-opt" id="exp-duration" onclick="selectExp('duration',this)">
              <input type="radio" name="expirationMode" value="duration" style="display:none;" />
              <div class="exp-opt-title">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 10h16"/><path d="M9 3v4"/><path d="M15 3v4"/>
                </svg>
                Durée fixe
              </div>
              <div class="exp-opt-sub" style="display:flex;align-items:center;gap:6px;">
                <input type="number" name="expirationDuration" value="24" min="1" max="720"
                  onclick="event.stopPropagation();"
                  style="width:52px;background:var(--bg);border:1px solid var(--border);color:var(--text);padding:3px 6px;border-radius:4px;font-family:var(--font-mono);font-size:12px;outline:none;" />
                <span style="font-size:11px;color:var(--text-dim);">heures</span>
              </div>
            </label>

            <label class="exp-opt" id="exp-never" onclick="selectExp('none',this)">
              <input type="radio" name="expirationMode" value="none" style="display:none;" />
              <div class="exp-opt-title">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8 12a4 4 0 1 1 4 4 4 4 0 0 0-4 4 4 4 0 1 1 0-8 4 4 0 0 0 4 4 4 4 0 1 1 0-8"/>
                </svg>
                Sans limite
              </div>
              <div class="exp-opt-sub">Suppression manuelle</div>
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div style="display:flex;justify-content:flex-end;gap:8px;">
      <a href="/gestion-liens" class="btn btn-ghost">Annuler</a>
      <button type="submit" class="btn btn-primary">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
        Créer le lien
      </button>
    </div>
  </form>
  </div>
</div>

<script>
(function () {
  // Tab switching
  var tabs = document.querySelectorAll('.seg-item[data-tab]');
  tabs.forEach(function (btn) {
    btn.addEventListener('click', function () {
      tabs.forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      document.getElementById('tab-torrent').style.display = btn.dataset.tab === 'torrent' ? '' : 'none';
      document.getElementById('tab-magnet').style.display  = btn.dataset.tab === 'magnet'  ? '' : 'none';
    });
  });

  // Torrent drag & drop
  var zone  = document.getElementById('torrent-zone');
  var input = document.getElementById('torrent-input');
  var title = document.getElementById('torrent-title');
  var sub   = document.getElementById('torrent-sub');

  function showFile(name) {
    title.textContent = name;
    sub.textContent = 'prêt à envoyer';
    sub.style.color = 'var(--success)';
  }

  input.addEventListener('change', function () {
    if (input.files && input.files[0]) showFile(input.files[0].name);
  });

  ['dragenter','dragover'].forEach(function (ev) {
    zone.addEventListener(ev, function (e) { e.preventDefault(); zone.classList.add('over'); });
  });
  ['dragleave','drop'].forEach(function (ev) {
    zone.addEventListener(ev, function (e) { e.preventDefault(); zone.classList.remove('over'); });
  });
  zone.addEventListener('drop', function (e) {
    var f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
    if (!f) return;
    try { var dt = new DataTransfer(); dt.items.add(f); input.files = dt.files; } catch(_) {}
    showFile(f.name);
  });

  // Password show/hide (only wire up if field exists in DOM)
  var toggleBtn = document.getElementById('toggle-pass');
  if (toggleBtn) {
    var passInput = document.getElementById('password-field');
    var eyeIcon   = document.getElementById('eye-icon');
    toggleBtn.addEventListener('click', function () {
      var show = passInput.type === 'text';
      passInput.type = show ? 'password' : 'text';
      eyeIcon.innerHTML = show
        ? '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>'
        : '<path d="M3 3l18 18"/><path d="M10.6 6.1A10 10 0 0 1 12 6c6.5 0 10 6 10 6a17 17 0 0 1-3.4 4"/><path d="M6.6 6.6A17 17 0 0 0 2 12s3.5 6 10 6c1.6 0 3-.3 4.2-.8"/>';
    });
  }
})();

function selectExp(val, el) {
  document.querySelectorAll('.exp-opt').forEach(function (o) { o.classList.remove('active'); });
  el.classList.add('active');
}

var _passActive = false;
function togglePasswordField() {
  _passActive = !_passActive;
  var wrap  = document.getElementById('password-wrap');
  var thumb = document.getElementById('pass-toggle-thumb');
  var track = document.getElementById('pass-toggle-track');
  var field = document.getElementById('password-field');
  if (_passActive) {
    wrap.style.display = 'block';
    thumb.style.transform = 'translateX(14px)';
    thumb.style.background = 'var(--accent)';
    track.style.background = 'var(--accent-soft)';
    track.style.borderColor = 'oklch(from var(--accent) l c h / 0.4)';
    setTimeout(function(){ field.focus(); }, 50);
  } else {
    wrap.style.display = 'none';
    thumb.style.transform = '';
    thumb.style.background = 'var(--text-faint)';
    track.style.background = 'var(--surface-active)';
    track.style.borderColor = 'var(--border)';
    field.value = '';
  }
}
</script>
