{
  "name": "shadebrid",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted UI to submit links/torrents to a debrid service and share download links",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:css": "mkdir -p public/styles && tailwindcss -c tailwind.config.cjs -i ./styles/tailwind.css -o ./public/styles/app.css --minify",
    "build:icons": "node scripts/generate-pwa-icons.mjs",
    "build": "npm run build:css && npm run build:icons && esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.js --packages=external --sourcemap",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/secure-session": "^8.2.0",
    "@fastify/static": "^8.1.1",
    "@fastify/view": "^11.1.0",
    "@prisma/client": "^6.7.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "bytes": "^3.1.2",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.10",
    "fastify": "^5.3.2",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@types/archiver": "^6.0.4",
    "@types/bytes": "^3.1.4",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.5",
    "prisma": "^6.7.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
