# URL publique de repli pour les liens de partage (sans slash final).
# Priorité réelle : 1) paramètre admin « URL publique »  2) Host / X-Forwarded-* de la requête  3) cette valeur.
PUBLIC_URL=http://localhost:3000

# Cookie de session marqué « Secure » (HTTPS). Valeurs : true | false | (vide = déduit de PUBLIC_URL si https)
# À mettre à true si HTTPS est terminé au proxy mais que le conteneur écoute en HTTP.
# SESSION_COOKIE_SECURE=true

# HTTP server
HOST=0.0.0.0
PORT=3000

# Session: 32-byte hex string used to sign+encrypt the session cookie
# Generate with: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_random_32_byte_hex_string_change_me_change

# SQLite DB path (relative to project root or absolute)
DATABASE_URL=file:./data/app.db

# Bootstrap admin (only used the first time, when the DB has no users)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=changeme

# Worker poll interval (ms) for magnet status on the debrid service
WORKER_INTERVAL_MS=15000

# Filet de sécurité APRÈS le 1er clic sur un fichier d'un lien single_use :
# fenêtre de retry en cas de coupure (en secondes).
SINGLE_USE_GRACE_SECONDS=300

# Durée de vie MAXIMALE d'un lien single_use SANS aucun clic (en secondes).
# Le timer démarre dès que le lien est "ready". Par défaut 1 h.
SINGLE_USE_MAX_LIFETIME_SECONDS=3600
